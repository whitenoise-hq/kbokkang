{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    // shadcn/ui(Radix)가 exactOptionalPropertyTypes를 지원하지 않는다.
    // 컴포넌트는 CLI로 재생성되므로 패치가 유지되지 않아 앱 단위로만 해제한다.
    // packages/shared 는 이 플래그를 계속 사용한다.
    "exactOptionalPropertyTypes": false,
    "allowJs": true,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
