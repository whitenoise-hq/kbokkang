# 크롤러는 service role 로 붙는다 — games upsert, settle_game RPC, crawl_runs 기록이
# 모두 RLS 로 막혀 있는 작업이다. 절대 클라이언트에 노출하지 않는다.
#
# 로컬 실행: 이 파일을 .env 로 복사해 채운다(.env 는 gitignore 됨)
# GitHub Actions: 레포 Settings > Secrets and variables > Actions 에 같은 이름으로 등록

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
